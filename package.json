{
  "name": "sandbox",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "tokens": "npm run tokens:check && node tokens/build.mjs",
    "tokens:check": "node tokens/check.mjs",
    "prestart": "npm run tokens",
    "prebuild": "npm run tokens",
    "build:lib": "npm run tokens && ng build ng-a11y",
    "storybook": "npm run tokens && ng run sandbox:storybook",
    "build-storybook": "npm run tokens && ng run sandbox:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.21.0",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/animations": "^22.2.6",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/angular-vite": "^10.6.7",
    "axe-core": "^4.14.0",
    "jsdom": "^28.0.0",
    "mediabunny": "^1.66.2",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.7",
    "style-dictionary": "^5.7.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.8"
  }
}
